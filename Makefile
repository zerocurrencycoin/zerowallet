ZeroWallet.app/Contents/PkgInfo: 
	@test -d ZeroWallet.app/Contents || mkdir -p ZeroWallet.app/Contents
	@$(DEL_FILE) ZeroWallet.app/Contents/PkgInfo
	@echo "APPL????" > ZeroWallet.app/Contents/PkgInfo
ZeroWallet.app/Contents/Resources/empty.lproj: 
	@test -d ZeroWallet.app/Contents/Resources || mkdir -p ZeroWallet.app/Contents/Resources
	@touch ZeroWallet.app/Contents/Resources/empty.lproj
	
ZeroWallet.app/Contents/Info.plist: 
	@test -d ZeroWallet.app/Contents || mkdir -p ZeroWallet.app/Contents
	@$(DEL_FILE) ZeroWallet.app/Contents/Info.plist
	@sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,com.yourcompany.ZeroWallet,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},com.yourcompany.ZeroWallet,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},10.13,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,@ICON@,logo.icns,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},logo.icns,g" -e "s,@EXECUTABLE@,ZeroWallet,g" -e "s,@LIBRARY@,ZeroWallet,g" -e "s,\$${EXECUTABLE_NAME},ZeroWallet,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" res/Info.plist >ZeroWallet.app/Contents/Info.plist
ZeroWallet.app/Contents/Resources/logo.icns: res/logo.icns
	@test -d ZeroWallet.app/Contents/Resources/ || mkdir -p ZeroWallet.app/Contents/Resources/
	@$(DEL_FILE) ZeroWallet.app/Contents/Resources/logo.icns
	@$(COPY_FILE) res/logo.icns ZeroWallet.app/Contents/Resources/logo.icns

all: Makefile \
