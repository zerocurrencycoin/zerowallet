####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/ZeroWallet/bin || mkdir -p $(INSTALL_ROOT)/opt/ZeroWallet/bin
	$(DEL_FILE) -r $(INSTALL_ROOT)/opt/ZeroWallet/bin/ZeroWallet.app
	
	$(QINSTALL) ZeroWallet.app $(INSTALL_ROOT)/opt/ZeroWallet/bin/ZeroWallet.app
	-$(STRIP) $(INSTALL_ROOT)/opt/ZeroWallet/bin/ZeroWallet.app/Contents/MacOS/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/opt/ZeroWallet/bin/ZeroWallet.app
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/ZeroWallet/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

